# Copy to .env.local and fill in your values.
# Local dummy login is enabled by default in npm run dev.
# Set false to use Supabase authentication locally. Ignored in production.
DEMO_AUTH_ENABLED=true

# Optional initial assistant provider (or configure it in Assistant).
JARVIS_API_BASE_URL=https://api.openai.com/v1
JARVIS_API_KEY=
JARVIS_MODEL=gpt-4o-mini

# Optional absolute Python path for Edge TTS. By default uses .venv-tts.
# Install the isolated runtime with: npm run setup:tts
JARVIS_TTS_PYTHON=

# Optional project key for browser-based account connections (or enter in Connections).
COMPOSIO_API_KEY=

# Get them from: Supabase Dashboard → Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Server only — never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx
